<?php

declare(strict_types=1);

// === Precision missing or different from the configured one (default: 0) ===
$sql = 'SELECT NOW(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT NOW(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT CURRENT_TIMESTAMP(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT CURRENT_TIME(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT SYSDATE(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT CURTIME(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'SELECT now(0) FROM t'; // @expect simbiat/sql-missing-precision
$sql = 'CREATE TABLE t (created DATETIME(0) NOT NULL, updated TIMESTAMP(0))'; // @expect simbiat/sql-missing-precision

// === UTC_* functions: both rules apply to UTC_TIMESTAMP and UTC_TIME ===
$sql = 'SELECT CURRENT_TIMESTAMP(0) FROM t'; // @expect simbiat/sql-prefer-current simbiat/sql-missing-precision
$sql = 'SELECT CURRENT_TIME(0) FROM t'; // @expect simbiat/sql-prefer-current simbiat/sql-missing-precision
$sql = 'select current_timestamp(0) from t'; // @expect simbiat/sql-prefer-current simbiat/sql-missing-precision
$sql = 'SELECT CURRENT_TIMESTAMP(0) FROM t'; // @expect simbiat/sql-prefer-current

// === UTC_DATE has no precision, so only PreferCurrent applies ===
$sql = 'SELECT CURRENT_DATE() FROM t'; // @expect simbiat/sql-prefer-current
$sql = 'SELECT CURRENT_DATE FROM t'; // @expect simbiat/sql-prefer-current

// === Several functions in one string: one result per code, all occurrences are fixed ===
$sql = 'SELECT NOW(0), CURRENT_TIMESTAMP(0), CURRENT_TIME(0) FROM t'; // @expect simbiat/sql-prefer-current simbiat/sql-missing-precision

// === One correct and one wrong occurrence in the same string: only the wrong one is changed ===
$sql = 'SELECT NOW(0), NOW(0) FROM t'; // @expect simbiat/sql-missing-precision

// === A backslash before the closing quote: an escaped backslash ends nothing, an escaped quote does not end the string ===
$sql = 'SELECT NOW(0) \\'; // @expect simbiat/sql-missing-precision
// @expect-next simbiat/sql-missing-precision
$sql = 'SELECT NOW(0)
    WHERE name = \'x\'
    AND 1';

// === Multibyte characters inside a comment must not shift the changes ===
// @expect-next simbiat/sql-missing-precision
$sql = 'SELECT 1 -- ünïcödé
, NOW(0) FROM t';
$sql = 'SELECT /* 日本語 */ NOW(0) FROM t'; // @expect simbiat/sql-missing-precision

// === Every SQL keyword that opens the gate ===
$sql = 'INSERT INTO t (created) VALUES (NOW(0))'; // @expect simbiat/sql-missing-precision
$sql = 'UPDATE t SET updated = NOW(0)'; // @expect simbiat/sql-missing-precision
$sql = 'DELETE FROM t WHERE created < NOW(0)'; // @expect simbiat/sql-missing-precision
$sql = 'REPLACE INTO t (created) VALUES (NOW(0))'; // @expect simbiat/sql-missing-precision
$sql = 'ALTER TABLE t ADD created DATETIME(0)'; // @expect simbiat/sql-missing-precision
$sql = 'WITH x AS (SELECT NOW(0)) SELECT * FROM x'; // @expect simbiat/sql-missing-precision
$sql = 'CALL do_something(NOW(0))'; // @expect simbiat/sql-missing-precision
$sql = '   SELECT NOW(0)'; // @expect simbiat/sql-missing-precision

// === Quote styles ===
$sql = "SELECT NOW(0) FROM t"; // @expect simbiat/sql-missing-precision
$sql = "SELECT NOW(0) FROM t WHERE id = $id"; // @expect simbiat/sql-missing-precision
$sql = 'SELECT \'x\', NOW(0) FROM t'; // @expect simbiat/sql-missing-precision

// === Multi-line strings: the result is reported on the first line ===
// @expect-next simbiat/sql-missing-precision
$sql = 'SELECT
    NOW(0)
FROM t';

// @expect-next simbiat/sql-prefer-current simbiat/sql-missing-precision
$sql = "SELECT
    CURRENT_TIMESTAMP(0),
    id
FROM t";

// === Heredoc: the result is reported on the first line of the body ===
// @expect+2 simbiat/sql-prefer-current simbiat/sql-missing-precision
$sql = <<<SQL
    SELECT CURRENT_TIMESTAMP(0), id
    FROM t
    SQL;

// === Comments are ignored ===
$sql = 'SELECT 1 -- NOW() is not used here';
$sql = 'SELECT 1 /* NOW() is not used here */';
// @expect-next simbiat/sql-missing-precision
$sql = 'SELECT
    /* a block comment that spans
       several lines, with UTC_TIMESTAMP() inside */
    NOW(0)
FROM t';

// === Already correct: must NOT be flagged ===
$sql = 'SELECT NOW(0) FROM t';
$sql = 'SELECT NOW( 0 ) FROM t';
$sql = 'SELECT CURRENT_TIMESTAMP(0) FROM t';
$sql = 'CREATE TABLE t (created DATETIME(0) NOT NULL)';
$sql = 'SELECT CURRENT_DATE FROM t';

// === The string does not start with an SQL keyword: must NOT be flagged ===
$message = 'Now it is NOW() o\'clock';
$message = 'Run SELECT NOW() to see the time';
$message = 'UTC_TIMESTAMP';
$message = '';
$message = 'S';

// === Not a whole word: must NOT be flagged ===
$sql = 'SELECT now_value, my_now, nowhere FROM t';
$sql = 'SELECT utc_timestamps FROM t';

// === Nowdoc is not checked (the sniff registers T_HEREDOC only) ===
$sql = <<<'SQL'
    SELECT NOW()
    SQL;

// === The case of the UTC_ prefix decides the case of CURRENT_, the case of the keyword is kept ===
$sql = 'SELECT CURRENT_date, current_DATE FROM t'; // @expect simbiat/sql-prefer-current

// === Several wrong calls in one string ===
$sql = 'SELECT NOW(0), CURTIME(0) FROM t'; // @expect simbiat/sql-missing-precision

// === Heredoc: a call on a later line is fixed, too ===
// @expect+2 simbiat/sql-missing-precision
$sql = <<<SQL
    SELECT id
    , NOW(0)
    FROM t
    SQL;
